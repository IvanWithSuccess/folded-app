{
  "productName": "Folded Git",
  "version": "1.0.1",
  "identifier": "com.folded.git",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
        {
          "label": "main",
          "title": "",
          "hiddenTitle": true,
          "width": 1050,
          "height": 720,
          "resizable": true,
          "transparent": true,
          "titleBarStyle": "Overlay"
        }
    ],


    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https: data:; video-src 'self' asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http: https: ws: wss:;",
      "assetProtocol": {
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "default",
          "description": "Default permissions",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "core:window:default",
            "core:window:allow-start-dragging",
            "dialog:default",

            "dialog:allow-open",
            "dialog:allow-confirm",
            "dialog:allow-message"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/tray-icon.png"
    ]
  }
}
